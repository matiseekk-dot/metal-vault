{
  "appId": "pl.skudev.metalvault",
  "appName": "Metal Vault",
  "webDir": "public",
  "server": {
    "url": "https://metal-vault-six.vercel.app",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "metal-vault-six.vercel.app",
      "*.supabase.co",
      "accounts.google.com",
      "oauth2.googleapis.com",
      "*.googleusercontent.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0a0a0a",
    "overrideUserAgent": "Mozilla/5.0 (Linux; Android 14; SM-A546B) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "spinnerColor": "#dc2626",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0a",
      "overlaysWebView": false
    },
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
