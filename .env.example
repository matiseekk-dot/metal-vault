# ╔══════════════════════════════════════════════════════════════╗
# ║  Metal Vault — Environment Variables                         ║
# ║  Copy to .env.local for local dev. Set on Vercel for prod.   ║
# ╚══════════════════════════════════════════════════════════════╝

# ── REQUIRED — App will not function without these ───────────────

# Supabase — auth + database + storage
# Get from supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# App URL — used in OAuth callbacks, Stripe redirects, internal cron calls
NEXT_PUBLIC_APP_URL=https://metal-vault-six.vercel.app

# Discogs — choose ONE option:
# (A) OAuth app — full sync per user, requires Discogs Developer setup at
#     discogs.com/settings/developers
DISCOGS_KEY=your_consumer_key
DISCOGS_SECRET=your_consumer_secret
# (B) Personal token — limited (no per-user OAuth, just app-wide quota)
DISCOGS_TOKEN=your_personal_token

# Cron security — protects /api/cron/* endpoints from being called publicly
# Generate via: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ── PAYMENTS (REQUIRED for Pro features) ─────────────────────────

# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Product Price IDs — create products in Stripe Dashboard
# Currently set to: $4.99/mo, $39.99/yr USD (matches lib/pricing.js)
# Stripe will auto-convert to user's local currency at checkout.
# Webhook endpoint: https://your-app.vercel.app/api/stripe/webhook
# Events: customer.subscription.*, checkout.session.completed, invoice.payment_failed
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ── CONCERTS (concert_proximity, tour announcements) ─────────────

# Ticketmaster Discovery API — for upcoming concerts
# Free signup at developer.ticketmaster.com (5000 req/day, 2/s rate limit)
# Replaces deprecated Bandsintown integration (now partnership-only)
TICKETMASTER_API_KEY=

# Setlist.fm — for past setlist data
# Get from setlist.fm/settings/api
SETLISTFM_API_KEY=

# ── PUSH NOTIFICATIONS (optional, but used by daily-digest cron) ──

# Generate via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── EMAIL (optional — for weekly release digests) ────────────────

# Resend — resend.com → API Keys
# 100 emails/day on free tier. From email can be onboarding@resend.dev
# until you verify your own domain.
RESEND_API_KEY=
FROM_EMAIL=Metal Vault <onboarding@resend.dev>

# ── eBay marketplace integration (optional) ──────────────────────

# eBay Browse API — for "Available now · price comparison" in album modal
# Get from developer.ebay.com (free, no business account needed)
EBAY_APP_ID=
EBAY_CERT_ID=

# eBay Partner Network campaign ID — REQUIRED only if affiliate links enabled
# Don't set this until you've registered with EPN (separate from API access)
EBAY_EPN_CAMPAIGN_ID=

# ── REVENUECAT (Play Store subscriptions, via TWA + Play Billing) ─

# How payments work on Android:
#   Bubblewrap-wrapped TWA exposes Play Billing through the standard Web
#   Platform `getDigitalGoodsService` + PaymentRequest APIs (NOT Capacitor).
#   The client gets a purchaseToken from PaymentRequest and POSTs it to
#   /api/revenuecat/record-purchase, which forwards it to the RC REST API.
#   RC validates with Google Play and fires our webhook, which updates
#   profiles.subscription_status.
#
# Bubblewrap setup (twa-manifest.json):
#   "playBilling": { "enabled": true }
#
# RevenueCat dashboard setup:
#   1. Create app in RC dashboard
#   2. Connect Play Console subscription products: mv_pro_monthly, mv_pro_yearly
#   3. Create entitlement 'pro' mapped to both products
#   4. Project Settings → Integrations → Webhooks → set URL to:
#      https://metal-vault-six.vercel.app/api/revenuecat/webhook
#   5. Set custom Authorization header: "Bearer <random-secret>"
#   6. Copy that secret to env var below
REVENUECAT_WEBHOOK_SECRET=

# Public SDK key. Used both client-side (Digital Goods + PaymentRequest path)
# and server-side (record-purchase route → RC REST /v1/receipts).
# Get from RC dashboard → Project Settings → API Keys → Public SDK key.
NEXT_PUBLIC_REVENUECAT_PUBLIC_KEY=

# ── ERROR MONITORING (optional but recommended for production) ──

# Sentry — sentry.io → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ── PRODUCT ANALYTICS (optional but RECOMMENDED for launch) ──
#
# PostHog — without this you fly blind on funnel/retention/paywall
# conversion. Lazy-loaded only when both keys are set; zero KB cost
# in dev or for installs that haven't enabled it.
#
# Setup:
#   1. Create a project at https://eu.posthog.com (or us.posthog.com)
#   2. Project Settings → Project API key → copy the public key
#   3. Set both env vars below in Vercel (Production + Preview)
#
# Default host = eu.i.posthog.com (data stays in EU). Override only
# if your project lives in US Cloud or self-hosted.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── SPOTIFY (optional — for share images, persona widget) ────────

# spotify.com → developer.spotify.com → Apps
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── METADATA AGGREGATORS (optional — improves search + artist info) ──
# These power the multi-source search (albums + artists + members) and
# the artist info modal (bio + members + similar). Each is independent —
# leave empty and the corresponding feature degrades gracefully:
#   • No LASTFM_API_KEY  → no bio, similar list comes from MusicBrainz only
#   • No MUSICBRAINZ_*   → MB still works (no key required), only User-Agent
#                          contact is missing
#
# Last.fm — free key from https://www.last.fm/api/account/create
# Used for: artist bio, listener count, similar artists with match scores.
LASTFM_API_KEY=
#
# MusicBrainz contact — required by their User-Agent policy. Any URL or
# email works as long as MB can reach you if they need to (they almost never
# do, but their ToS demands it). Falls back to NEXT_PUBLIC_APP_URL if unset.
MUSICBRAINZ_CONTACT=

# Cover Art Archive needs no key — it uses the MBID resolved from MusicBrainz.
