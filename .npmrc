# Always save exact versions — no ^ or ~ drift
save-exact=true

# Permit peer-dependency mismatches during install. We need this
# because @codetrix-studio/capacitor-google-auth currently pins its
# peer to @capacitor/core@^6.0.0, while the rest of our stack runs
# on Capacitor 8 (auto-upgraded by `npx cap add android`). The
# plugin's runtime code works fine against 7 / 8 — the peer-version
# pin is just stale. Without this flag Vercel's `npm install` fails
# the build (it uses npm 7+ which enforces peer ranges strictly,
# unlike local installs where we passed --legacy-peer-deps manually).
# Revisit when the plugin ships a Capacitor 8 release.
legacy-peer-deps=true
