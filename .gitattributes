# Normalize line endings to LF in the repo regardless of platform.
# Keeps `git diff` clean on Windows checkouts where the working tree
# uses CRLF but the index stays LF.
* text=auto eol=lf

# Binary assets — git should not try to text-normalize these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.aab  binary
*.apk  binary
*.keystore binary
