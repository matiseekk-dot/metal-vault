# Capacitor / Gradle release signing — local file, NEVER commit.
# Copy this template to `keystore.properties` (no .example), fill in
# the password, and Gradle will pick it up automatically when running
# `./gradlew bundleRelease`. The .gitignore already excludes the real
# file so a password never lands in a public commit.
#
# Same upload key that signed every TWA AAB you've shipped, so the
# Play Store will accept the WebView wrapper as a regular update of
# the existing pl.skudev.metalvault listing — no signature mismatch.

storeFile=C:/Users/kinga/Desktop/Aplikacje/metal-vault/android.keystore
storePassword=PASTE_FROM_KEYSTORE_PASSWORD_TXT_HERE
keyAlias=android
keyPassword=PASTE_FROM_KEYSTORE_PASSWORD_TXT_HERE
